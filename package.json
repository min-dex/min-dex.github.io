{
  "name": "mindex",
  "version": "0.1.1",
  "private": true,
  "description": "Mindex desktop shell",
  "author": "Mindex",
  "packageManager": "pnpm@11.9.0",
  "main": "electron/main.js",
  "scripts": {
    "dev:web": "python3 serve.py",
    "electron:dev": "electron .",
    "dist:clean": "node scripts/clean-electron-dist.mjs",
    "dist:prune": "node scripts/prune-electron-dist.mjs",
    "package:audit": "node scripts/audit-electron-package.mjs",
    "electron:pack": "pnpm run dist:clean && electron-builder --publish never --dir && node scripts/clear-local-quarantine.mjs",
    "electron:pack:raw": "pnpm run dist:clean && electron-builder --publish never --dir",
    "electron:dist": "pnpm run dist:clean && electron-builder --publish never && pnpm run dist:prune",
    "electron:dist:mac:arm64": "pnpm run dist:clean && electron-builder --publish never --mac dmg zip --arm64 && pnpm run dist:prune",
    "electron:dist:mac:x64": "pnpm run dist:clean && electron-builder --publish never --mac dmg zip --x64 && pnpm run dist:prune",
    "electron:dist:win:x64": "pnpm run dist:clean && electron-builder --publish never --win nsis --x64 && pnpm run dist:prune",
    "electron:release": "node scripts/release-electron.mjs",
    "test:desktop": "node --test tests/test_electron_updater.cjs tests/test_release_preflight.mjs tests/test_desktop_update_ui.cjs && python3 tests/test_electron_runtime_files.py && node tests/test_worship_input_module_contract.cjs",
    "electron:check": "node scripts/verify-release.mjs --offline",
    "electron:release:mac": "node scripts/release-electron.mjs --platform=mac",
    "electron:release:win": "node scripts/release-electron.mjs --platform=win",
    "electron:test:mac": "node scripts/verify-release.mjs --offline && electron-builder --config electron-builder.test.cjs --mac dmg --arm64 --x64 --publish never",
    "electron:test:win": "node scripts/verify-release.mjs --offline && electron-builder --config electron-builder.test.cjs --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "kr.mindex.app",
    "productName": "Mindex",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "min-dex",
        "repo": "min-dex.github.io",
        "releaseType": "release"
      }
    ],
    "files": [
      "index.html",
      "mindex-release.json",
      "app.js",
      "app.runtime.js",
      "mindex.icons.js",
      "mindex.worship-week.js",
      "mindex.monitor.js",
      "mindex.remote.js",
      "mindex.remote-core.mjs",
      "mindex.remote-session.mjs",
      "mindex.remote-pairing.mjs",
      "mindex.public-config.js",
      "remote.html",
      "remote.mjs",
      "remote.screen.mjs",
      "remote.css",
      "remote.shared.css",
      "remote.webmanifest",
      "mindex.service-entry.js",
      "mindex.worship-live.js",
      "mindex.content-live.js",
      "mindex.service-list-live.js",
      "mindex.archive-live.js",
      "mindex.single-song.js",
      "mindex.constants.js",
      "mindex.design-tokens.js",
      "mindex.worship-model.js",
      "mindex.worship-persistence.js",
      "mindex.presenter.js",
      "mindex.presenter-praise.js",
      "mindex.presenter-live.js",
      "mindex.presenter-board.js",
      "mindex.presenter-history.js",
      "mindex.presenter-media-state.js",
      "mindex.presenter-controller.js",
      "mindex.song-timing.js",
      "mindex.scripture-repair-display.js",
      "mindex.pptx.js",
      "mindex.worship-input.js",
      "mindex.presenter-ui.js",
      "mindex.setlist-links.js",
      "mindex.manuals.js",
      "mindex.bulletin.js",
      "mindex.inline-text.js",
      "mindex.worship-source.js",
      "mindex.worship-atomic-client.mjs",
      "mindex.worship-store.mjs",
      "mindex.server-state.mjs",
      "mindex.legacy-state.mjs",
      "mindex.server-storage.js",
      "mindex.disclosure-state.js",
      "mindex.editor-drafts.js",
      "styles*.css",
      "favicon.ico",
      "manifest.webmanifest",
      "assets/**/*",
      "vendor/**/*",
      "electron/**/*",
      "package.json",
      "!dist/**/*",
      "!backups/**/*",
      "!tmp/**/*",
      "!tests/**/*",
      "!docs/**/*",
      "docs/manuals/**/*",
      "!scripts/**/*",
      "!data/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "mindex.draft-handoff.js",
      "mindex.presenter-freshness.js",
      "mindex.hymn-structure.js",
      "mindex.hymn-structure.runtime.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "notarize": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "devDependencies": {
    "electron": "43.8.1",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "fs-extra": "^11.4.1",
    "graceful-fs": "^4.2.11",
    "jsonfile": "^6.2.1",
    "universalify": "^2.0.1"
  }
}
